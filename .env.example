# ---------------------------------------------------------------
# DeepTrace environment configuration
# Copy to `.env` and fill in real secrets. NEVER commit `.env`.
# ---------------------------------------------------------------

# --- Application ---
APP_NAME=DeepTrace
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database (SQLite for dev; Postgres for production) ---
DATABASE_URL=sqlite:///./deeptrace.db

# --- Encryption (Fernet). Generate with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EVIDENCE_ENCRYPTION_KEY=

# --- Storage ---
STORAGE_ROOT=./storage
MAX_UPLOAD_SIZE_MB=2048

# --- CORS ---
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Seed admin (only used on first boot when DB is empty) ---
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@deeptrace.local
SEED_ADMIN_PASSWORD=ChangeMe!2026

# --- Volatility 3 (optional; leave blank to disable) ---
VOLATILITY_PATH=

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000/api